{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe 生成活动文件",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/MDd",
                "/I", "D:/OpenCV/opencv_build/include",
                "${file}",
                "/link",
                "/LIBPATH:D:/OpenCV/opencv_build/x64/vc17/lib",
                "opencv_world4100d.lib"
            ],
            "problemMatcher": ["$msCompile"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}